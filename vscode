#!/bin/bash

# ==============================================================================
#  VS CODE FOR TERMUX - ULTIMATE EDITION
#  Author: Mahesh Technicals
#  Fix: Extension signature verification bypass + smart settings merge
# ==============================================================================

# --- 1. DEFINING COLORS & STYLES ---
RESET="\033[0m"
BOLD="\033[1m"

# Gradient-like Palette (Simulated)
C1="\033[38;5;196m" # Red
C2="\033[38;5;202m" # Orange
C3="\033[38;5;220m" # Yellow
C4="\033[38;5;46m"  # Green
C5="\033[38;5;51m"  # Cyan
C6="\033[38;5;21m"  # Blue
C7="\033[38;5;201m" # Purple
C8="\033[38;5;255m" # White

# Status Colors
SUCCESS="${BOLD}${C4}"
ERROR="${BOLD}${C1}"
INFO="${BOLD}${C5}"
WARN="${BOLD}${C3}"

# --- 2. HEADER FUNCTION ---
draw_header() {
    clear
    echo -e "${C6}======================================================${RESET}"
    echo -e "${C5}    🚀  V S   C O D E   F O R   T E R M U X  🚀   ${RESET}"
    echo -e "${C6}======================================================${RESET}"
    echo -e "${C7}         ✨  Created by Mahesh Technicals  ✨       ${RESET}"
    echo -e "${C6}======================================================${RESET}"
    echo ""
}

# --- 3. ARCHITECTURE CHECK ---
if [ "$(dpkg --print-architecture)" != "arm64" ]; then
    echo -e "${ERROR}❌ FATAL ERROR: This script is only for arm64 (Termux/Android).${RESET}"
    exit 1
fi

draw_header
echo -e "${BOLD}Choose an action:${RESET}"
echo -e "${C4}[1]${RESET} 📦 Install / Update VS Code ${C2}(Safe Mode)${RESET}"
echo -e "${C1}[2]${RESET} 🗑️  Uninstall VS Code Completely"
echo -e "${C6}------------------------------------------------------${RESET}"
read -p "👉 Enter your choice [1 or 2]: " choice

# ==============================================================================
# HELPER: Safely merge a key:value into an existing JSON settings file
# Usage: merge_json_setting <file> <key> <value>
# Value should be passed WITHOUT quotes for booleans/numbers, WITH for strings
# ==============================================================================
merge_json_setting() {
    local file="$1"
    local key="$2"
    local value="$3"

    if grep -q "\"$key\"" "$file" 2>/dev/null; then
        # Key exists — update its value
        sed -i "s|\"$key\"\s*:\s*[^,}]*|\"$key\": $value|g" "$file"
    else
        # Key missing — inject before last closing brace
        sed -i "s|}[[:space:]]*$|,\n    \"$key\": $value\n}|" "$file"
    fi
}

# ==========================================================
# FUNCTION: INSTALL / UPDATE
# ==========================================================
install_vscode() {
    draw_header

    # --- STEP 0: CHECK CURRENT VERSION ---
    echo -e "${INFO}🔍 Checking current status...${RESET}"
    if command -v code &> /dev/null; then
        OLD_VER=$(code --no-sandbox --disable-gpu --version 2>/dev/null | head -n 1)
        echo -e "   ➡️  Current Version: ${C3}$OLD_VER${RESET}"
    else
        OLD_VER="None"
        echo -e "   ➡️  Current Version: ${C2}Not Installed${RESET}"
    fi

    echo -e "\n${INFO}⬇️  Starting Download...${RESET}"

    # --- STEP 1: DOWNLOAD ---
    rm -f vscode_latest.deb
    wget -q --show-progress "https://code.visualstudio.com/sha/download?build=stable&os=linux-deb-arm64" -O vscode_latest.deb

    if [ ! -s vscode_latest.deb ]; then
        echo -e "${ERROR}❌ ERROR: Download failed. Check internet connection.${RESET}"
        exit 1
    fi

    # --- STEP 2: EXTRACT ---
    echo -e "\n${INFO}📦 Extracting files...${RESET}"
    rm -rf vscode_temp
    mkdir -p vscode_temp || { echo -e "${ERROR}❌ ERROR: Cannot create temp directory.${RESET}"; exit 1; }
    cd vscode_temp || { echo -e "${ERROR}❌ ERROR: Cannot enter temp directory.${RESET}"; exit 1; }

    ar x ../vscode_latest.deb

    if [ -f data.tar.zst ]; then
        tar --use-compress-program=unzstd -xf data.tar.zst 2>/dev/null \
            || { echo -e "${WARN}   ⚠️  zstd not found, trying zstdcat...${RESET}"; zstdcat data.tar.zst | tar -xf -; }
    elif [ -f data.tar.xz ]; then
        tar -xf data.tar.xz
    elif [ -f data.tar.gz ]; then
        tar -xf data.tar.gz
    else
        echo -e "${ERROR}❌ ERROR: Unknown archive format inside .deb${RESET}"
        cd ..
        rm -rf vscode_temp vscode_latest.deb
        exit 1
    fi

    # --- STEP 3: INSTALL ---
    echo -e "${INFO}📂 Installing to system...${RESET}"
    if [ -d usr ]; then
        sudo cp -rf usr/* /usr/
        sudo chmod -R 755 /usr/share/code
        echo -e "${SUCCESS}   ✅ Files copied successfully.${RESET}"

        echo -e "${INFO}🔗 Linking command...${RESET}"
        sudo ln -sf /usr/share/code/bin/code /usr/bin/code
        echo -e "${SUCCESS}   ✅ Symlink created: /usr/bin/code${RESET}"
    else
        echo -e "${ERROR}❌ ERROR: Extraction failed. 'usr' directory not found.${RESET}"
        cd ..
        rm -rf vscode_temp vscode_latest.deb
        exit 1
    fi

    # --- STEP 4: CLEANUP ---
    cd ..
    rm -rf vscode_temp vscode_latest.deb
    echo -e "${SUCCESS}   ✅ Temp files cleaned.${RESET}"

    # --- STEP 5: PATCH DESKTOP SHORTCUT ---
    DESKTOP_FILE="/usr/share/applications/code.desktop"
    if [ -f "$DESKTOP_FILE" ]; then
        echo -e "\n${INFO}🔧 Patching Desktop Shortcut...${RESET}"
        sudo sed -i \
            's|^Exec=/usr/share/code/code|Exec=/usr/share/code/code --no-sandbox --disable-gpu --password-store="basic"|g' \
            "$DESKTOP_FILE"
        echo -e "${SUCCESS}   ✅ Keyring & GPU crash fixed in shortcut.${RESET}"
    fi

    # --- STEP 6: SMART SETTINGS MERGE ---
    echo -e "\n${INFO}⚙️  Configuring User Settings...${RESET}"
    SETTINGS_FILE="$HOME/.config/Code/User/settings.json"
    mkdir -p "$HOME/.config/Code/User"

    if [ -f "$SETTINGS_FILE" ]; then
        echo -e "${WARN}   ⚠️  Existing settings.json found. Merging required keys...${RESET}"

        merge_json_setting "$SETTINGS_FILE" "extensions.verifySignature"        "false"
        merge_json_setting "$SETTINGS_FILE" "settingsSync.keychain"             "false"
        merge_json_setting "$SETTINGS_FILE" "security.workspace.trust.enabled"  "false"
        merge_json_setting "$SETTINGS_FILE" "telemetry.telemetryLevel"          '"off"'
        merge_json_setting "$SETTINGS_FILE" "update.mode"                       '"manual"'
        merge_json_setting "$SETTINGS_FILE" "window.titleBarStyle"              '"custom"'

        echo -e "${SUCCESS}   ✅ Settings merged successfully (your config preserved).${RESET}"
    else
        echo -e "${SUCCESS}   ✅ Creating optimized defaults for Termux...${RESET}"
        cat <<EOF > "$SETTINGS_FILE"
{
    "extensions.verifySignature": false,
    "settingsSync.keychain": false,
    "security.workspace.trust.enabled": false,
    "telemetry.telemetryLevel": "off",
    "update.mode": "manual",
    "window.titleBarStyle": "custom"
}
EOF
        echo -e "${SUCCESS}   ✅ settings.json created.${RESET}"
    fi

    # --- STEP 7: PATCH argv.json (startup flags — fixes keyring + GPU at launch) ---
    echo -e "\n${INFO}🔧 Patching argv.json (startup flags)...${RESET}"
    ARGV_FILE="$HOME/.vscode/argv.json"
    mkdir -p "$HOME/.vscode"

    if [ -f "$ARGV_FILE" ]; then
        echo -e "${WARN}   ⚠️  Existing argv.json found. Merging flags...${RESET}"
        merge_json_setting "$ARGV_FILE" "disable-hardware-acceleration" "true"
        merge_json_setting "$ARGV_FILE" "password-store"                '"basic"'
        echo -e "${SUCCESS}   ✅ argv.json patched.${RESET}"
    else
        cat <<EOF > "$ARGV_FILE"
{
    "disable-hardware-acceleration": true,
    "password-store": "basic"
}
EOF
        echo -e "${SUCCESS}   ✅ argv.json created.${RESET}"
    fi

    # --- STEP 8: SUMMARY ---
    NEW_VER=$(code --no-sandbox --disable-gpu --version 2>/dev/null | head -n 1)

    echo -e "\n${C6}======================================================${RESET}"
    echo -e "${C4}           🎉  INSTALLATION COMPLETE  🎉            ${RESET}"
    echo -e "${C6}======================================================${RESET}"
    echo -e "   📂 Old Version : ${C1}${OLD_VER:-None}${RESET}"
    echo -e "   📂 New Version : ${C4}${NEW_VER:-Unknown}${RESET}"
    echo -e "${C6}------------------------------------------------------${RESET}"
    echo -e "   ${C5}🔑 Extension signature verification : ${C4}DISABLED${RESET}"
    echo -e "   ${C5}🖥️  GPU acceleration                 : ${C4}DISABLED${RESET}"
    echo -e "   ${C5}🔒 Keyring / Password store          : ${C4}BASIC (no popup)${RESET}"
    echo -e "${C6}======================================================${RESET}"

    if [ -n "$NEW_VER" ] && [ "$OLD_VER" = "$NEW_VER" ]; then
        echo -e "${INFO}   ℹ️  Already up to date!${RESET}"
    elif [ -n "$NEW_VER" ]; then
        echo -e "${SUCCESS}   🚀 Update Successful!${RESET}"
    else
        echo -e "${WARN}   ⚠️  Could not verify new version. Try: code --no-sandbox --version${RESET}"
    fi
    echo ""
}

# ==========================================================
# FUNCTION: UNINSTALL
# ==========================================================
uninstall_vscode() {
    echo -e "\n${C1}======================================================${RESET}"
    echo -e "${C1}             ⚠️   UNINSTALL WARNING   ⚠️              ${RESET}"
    echo -e "${C1}======================================================${RESET}"
    echo -e "This will delete VS Code and ALL extensions/data."
    read -p "👉 Are you sure you want to proceed? (y/n): " confirm

    if [[ "$confirm" != "y" && "$confirm" != "Y" ]]; then
        echo -e "${SUCCESS}🚫 Cancelled.${RESET}"
        exit 0
    fi

    echo -e "\n${INFO}🧹 Cleaning up...${RESET}"

    sudo dpkg --remove --force-all code 2>/dev/null
    echo -e "   🗑️  Removed Package Entry"

    sudo rm -rf /usr/share/code /usr/bin/code
    echo -e "   🗑️  Deleted Application Files"

    sudo rm -f /usr/share/applications/code.desktop ~/Desktop/code.desktop
    echo -e "   🗑️  Removed Shortcuts"

    rm -rf ~/.vscode ~/.config/Code
    echo -e "   🗑️  Wiped User Data & Settings"

    sudo apt autoremove -y >/dev/null 2>&1

    echo -e "\n${SUCCESS}✅ VS Code has been completely removed.${RESET}"
}

# ==========================================================
# MAIN LOGIC
# ==========================================================
case "$choice" in
    1) install_vscode ;;
    2) uninstall_vscode ;;
    *) echo -e "${ERROR}❌ Invalid choice. Exiting.${RESET}"; exit 1 ;;
esac

